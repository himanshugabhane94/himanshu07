# ==============================================================================
# SUTRA (.gitignore) — Comprehensive Full-Stack Ignore Rules
# ==============================================================================

# --- Node / Frontend Dependencies & Builds ---
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp
.pnp.js
.yarn/install-state.gz

# Frontend, Vite & Next.js Builds
dist/
frontend/dist/
build/
out/
.next/
*.tsbuildinfo
next-env.d.ts

# --- Python / Backend Virtual Environments & Caches ---
__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Virtual Environments
venv/
.venv/
env/
.env_python/
ENV/

# --- Environment & Secret Configuration Files ---
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env.production
*.pem
*.key
*.cert

# --- Databases & Ledger Snapshots ---
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
prisma/*.db
prisma/*.db-journal

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vercel
.vercel
